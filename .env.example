# ================================
# Call Closer Hub - Environment Variables
# ================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# ================================
# SUPABASE CONFIGURATION
# ================================
# Get these from: Supabase Dashboard → Settings → API

# Supabase Project URL (public, safe for frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (public, safe for frontend - this is the "anon" key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SECRET - backend/Edge Functions only, NEVER expose to frontend!)
# This is the "service_role" key - has full database access
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ================================
# OPENAI API CONFIGURATION
# ================================
# Get from: https://platform.openai.com/api-keys
# IMPORTANT: Set spending limits in your OpenAI account!

# OpenAI API Key (starts with sk-...)
OPENAI_API_KEY=sk-proj-...your-key-here

# ================================
# GOOGLE OAUTH & DRIVE API
# ================================
# Get from: Google Cloud Console → APIs & Services → Credentials
# 1. Create OAuth 2.0 Client ID
# 2. Enable Google Drive API and Google Docs API
# 3. Add authorized redirect URIs:
#    - https://your-project-id.supabase.co/auth/v1/callback
#    - http://localhost:5173/auth/callback (for local dev)

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=GOCSPX-...your-secret

# ================================
# OPTIONAL: ANTHROPIC API (Future fallback)
# ================================
# Get from: https://console.anthropic.com/
# Only needed if implementing AI provider fallback

# ANTHROPIC_API_KEY=sk-ant-...your-key

# ================================
# DEVELOPMENT SETTINGS
# ================================
# Local development server port (Vite default)
# PORT=5173

# Enable debug logging (optional)
# DEBUG=true

# ================================
# PRODUCTION SETTINGS
# ================================
# These are typically set in your hosting platform (Lovable, Vercel, Netlify, etc.)
# Not needed in local .env file

# NODE_ENV=production

# ================================
# NOTES
# ================================
# 1. After setting up, run: npm install
# 2. For local dev: npm run dev
# 3. For production deployment: See DEPLOYMENT.md
# 4. Budget limits are set in database (default $100/month per user)
# 5. Never share your .env file or commit it to git!
